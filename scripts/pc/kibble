class Shell:
    """A long-lived shell over ssh, so cd and variables carry from one command to the next.

    A running command reads its input from a FIFO (fd 3) fed over a second ssh, which is how
    answers like the `y` for pacman's "Proceed? [Y/n]" reach it. The shell's own stdin stays
    reserved for the shell's script."""

    def __init__(self, app, name, remote, fifo_in_shell, fifo_on_host):
        self.app, self.name, self.remote = app, name, remote
        self.fifo, self.fifo_host = fifo_in_shell, fifo_on_host
        self.cwd, self.proc, self.pid, self.feeder = "~", None, None, None

    def start(self):
        self.proc = subprocess.Popen(ssh_argv(self.remote), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.STDOUT, bufsize=0, env=child_env())
        self.pid = None
        threading.Thread(target=self.reader, args=(self.proc,), daemon=True).start()
        f = self.fifo
        # trap INT so the shell survives when Ctrl-C kills a command (children still get the default action)
        self.write(f'trap : INT; rm -f {f}; mkfifo {f} 2>/dev/null && exec 3<>{f} || exec 3</dev/null; echo "{INIT} $$"\n')

    def write(self, text):
        self.proc.stdin.write(text.encode())
        self.proc.stdin.flush()

    def kill(self):
        for pr in (self.proc, self.feeder):
            if pr and pr.poll() is None:
                pr.kill()
        self.proc = self.feeder = self.pid = None

    def run(self, line):
        if not self.proc or self.proc.poll() is not None:
            self.start()
        self.write(f'{{ {line}\n}} <&3 2>&1; echo "{DONE} $? $PWD"\n')

    def send_input(self, text):
        if not self.feeder or self.feeder.poll() is not None:
            self.feeder = subprocess.Popen(ssh_argv(f"cat > {self.fifo_host}"), stdin=subprocess.PIPE,
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=child_env())
        self.feeder.stdin.write((text + "\n").encode())
        self.feeder.stdin.flush()

    def interrupt(self, token):
        """Stop the running command the way Ctrl-C would: SIGINT first (pacman, for one, only cleans up
        its lock on SIGINT), then SIGTERM. The shell survives. If the command ignores both, give up on
        the whole session."""
        if not self.pid:
            self.app.stop_running("no shell pid known")
            return

        def signal_children(sig):
            # toybox pkill can't select by parent without a name, so walk ps
            cmd = (f'ps -A -o PID,PPID | while read p pp; do [ "$pp" = "{self.pid}" ] && kill -{sig} $p; done')
            subprocess.run(ssh_argv(cmd, 15), capture_output=True, env=child_env(), stdin=subprocess.DEVNULL)

        def work():
            for sig, wait in (("INT", 6), ("TERM", 6)):
                signal_children(sig)
                time.sleep(wait)
                if not (self.app.active is self and self.app.busy_since == token):
                    return
            self.app.stop_running("the command ignored the stop requests")
        threading.Thread(target=work, daemon=True).start()

    def reader(self, proc):
        dec = codecs.getincrementaldecoder("utf-8")("replace")
        fd, pend = proc.stdout.fileno(), ""
        while True:
            try:
                chunk = os.read(fd, 65536)
            except OSError:
                break
            if not chunk:
                break
            pend += dec.decode(chunk).replace("\t", "    ")
            while "\n" in pend:
                line, pend = pend.split("\n", 1)
                self.line(ANSI.sub("", line.split("\r")[-1]))
            self.app.set_partial(self, ANSI.sub("", pend.split("\r")[-1]))    # a prompt waiting for input
        if proc is self.proc:                    # the shell itself ended (e.g. `exit`)
            self.proc = None
            self.app.add(f"[{self.name} shell closed; the next command starts a new one]")
            self.app.finish(self)

    def line(self, line):
        i = line.find(INIT)
        if i >= 0:
            self.pid = line[i + len(INIT):].strip() or None
            return
        i = line.find(DONE)
        if i < 0:
            self.app.add(line)
            return
        if line[:i]:
            self.app.add(line[:i])
        rc, _, cwd = line[i + len(DONE):].strip().partition(" ")
        self.cwd = cwd or self.cwd
        if rc not in ("0", ""):
            self.app.add(f"[exit {rc}]")
        self.app.finish(self)


# ---------------------------------------------------------------- what to show

def bar(pct, width, color):
    pct = max(0, min(100, pct))
    n = round(width * pct / 100)
    return [("█" * n, color), ("░" * (width - n), "grey")]


def fmt_dur(s):
    s = int(s)
    if s < 90:
        return f"{s}s"
    if s < 5400:
        return f"{s // 60}m"
    return f"{s // 3600}h{(s % 3600) // 60:02d}m"


def level(pct, warn, bad):
    return "red" if pct >= bad else "yellow" if pct >= warn else "lime"


def panels(st, err, bw=14):
    """(left, right): lists of lines, each a list of (text, color) pieces."""
    if st is None:
        return [[(f"can't reach the phone:", "red")], [(str(err), "red")]], []
    j = fresh_json(st)
    zy = st.get("zygote", "?")
    mode = ("Android UI on", "cyan") if zy == "running" else ("headless", "lime") if zy == "stopped" \
        else (f"zygote {zy}", "yellow")
    flag = [("  (flag set)", "grey")] if st.get("headless_flag") == "1" else []
    if not j:
        left = [[("MODE", "grey")], [mode, *flag], []]
        left += [[(l, "white")] for l in st["once"]]
        right = [[("DAEMON", "grey")],
                 [("not running (fine while Android is on)", "cyan")] if zy == "running"
                 else [("NOT RUNNING and the UI is off!", "red")], [("run ui.sh on", "red")] if zy != "running" else []]
        return left, right
    b, m, n, d, w, s = j["battery"], j["memory"], j["network"], j["dhcp"], j["watchdog"], j["services"]
    bc = "red" if b["percent"] < 20 else "yellow" if b["percent"] < 50 else "lime"
    mp = 100 * m["used_mb"] // m["total_mb"]
    left = [
        [("BATTERY", "grey")],
        bar(b["percent"], bw, bc) + [(f" {b['percent']}%", bc)],
        [(f"{b['state']}  {b['temp_c']}°C", "white")],
        [],
        [("MEMORY", "grey")],
        bar(mp, bw, level(mp, 60, 85)) + [(f" {m['used_mb']}MB", "white")],
        [(f"of {m['total_mb']} MB", "grey")],
        [],
        [("MODE", "grey")],
        [mode, *flag],
    ]
    ok = n["gateway_reachable"]
    age = fed_age(st)
    fed = age is not None and age <= FED_OK_S
    right = [
        [("ROUTER", "grey")],
        [("● " if ok else "● DOWN ", "lime" if ok else "red"),
         (n["ip"] if ok else fmt_dur(n["down_for_s"]), "white")],
        [(f"via {n['gateway']}", "grey")],
        [],
        [("DHCP", "grey")],
        [((f"lease {fmt_dur(d['lease_s'])}, renew {fmt_dur(d['next_renewal_in_s'])}"
           + (f", {d['naks']} NAK" if d["naks"] else "")) if d["enabled"] else "off", "white")],
        [],
        [("WATCHDOG", "grey")],
        [("● " if fed else "● ", "lime" if fed else "red"),
         (f"fed {age}s ago" if age is not None else "not held", "white")],
        [],
        [("SSH", "grey")],
        [("● ", "lime" if s["ssh_android_22"] else "red"), ("android  ", "white"),
         ("● ", "lime" if s["ssh_chroot_2222"] else "red"), ("chroot", "white")],
        [],
        [("PHONE UP", "grey")],
        [(fmt_dur(j["uptime_s"]), "white")],
    ]
    return left, right


# ---------------------------------------------------------------- the dog

ASCII_DOG = {
    "fed": ["   __       ", " o(__)\\____ ", "  /     __)%s", " (_|_|--|_|  ", "  good boy   "],
    "hungry": ["   __       ", " o(__)\\____ ", "  /     __)_", " (_|_|--|_|  ", " feed me! \\_/"],
    "asleep": ["       %s   ", "   ___      ", " (_____)\\__ ", " (_|_|--|_|  ", "  sleeping   "],
    "lost": ["  ?  __     ", " o(__)\\____ ", "  /     __)_", " (_|_|--|_|  ", " where is it "],
}


def ascii_dog(m, tick):
    sub = {"fed": "~-", "asleep": "zZ"}.get(m)
    return [l % sub[tick % 2] if sub and "%s" in l else l for l in ASCII_DOG[m]]



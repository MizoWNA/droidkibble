BASE = "/data/adb/phoneserver"
POLL = (
    f'D={BASE}; echo "now=$(date +%s)"; echo "zygote=$(getprop init.svc.zygote)"; '
    f'echo "headless_flag=$([ -e $D/headless ] && echo 1 || echo 0)"; '
    f'echo ---json; cat $D/status.json 2>/dev/null; echo; '
    f'echo ---once; $D/phoneserverd --once 2>/dev/null'
)
DONE = "__KB_DONE__"
INIT = "__KB_INIT__"
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
FED_OK_S = 15          # the daemon feeds every 5 s; slower than this looks wrong
STALE_S = 20           # status.json older than this is not from a running daemon
CONF = os.path.expanduser("~/.config/droidkibble/phone.json")
CACHE = os.path.expanduser("~/.cache/droidkibble")
SSH_CONFIG = os.path.expanduser("~/.ssh/config")
MARK_A, MARK_B = "# >>> droidkibble (managed by `kibble ssh-config`)", "# <<< droidkibble"


# ---------------------------------------------------------------- how to reach the phone

class Target:
    """How ssh reaches and logs in to the phone."""

    def __init__(self, host="", opts=None, env=None):
        self.host, self.env = host, env or {}
        self.opts = opts if opts is not None else ["-o", "BatchMode=yes"]


TARGET = Target()


def ssh_argv(remote, timeout=None, target=None):
    t = target or TARGET
    os.makedirs(CACHE, exist_ok=True)
    argv = ["ssh", "-o", "ConnectTimeout=8", "-o", "ServerAliveInterval=5", "-o", "ControlMaster=auto",
            "-o", "ControlPersist=120", "-o", f"ControlPath={CACHE}/cm-%C", *t.opts, t.host, remote]
    return ["timeout", str(timeout)] + argv if timeout else argv


def child_env(target=None):
    e = os.environ.copy()
    e.update((target or TARGET).env)
    return e


def key_target(ip, user, key):
    opts = ["-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new"]
    if key:
        opts += ["-i", key, "-o", "IdentitiesOnly=yes"]
    return Target(f"{user}@{ip}", opts)


def password_target(ip, user, password):
    """ssh has no password flag; SSH_ASKPASS with a tiny helper hands it over. Kept in memory only."""
    os.makedirs(CACHE, exist_ok=True)
    helper = os.path.join(CACHE, "askpass.sh")
    with open(helper, "w") as f:
        f.write('#!/bin/sh\nprintf "%s\\n" "$KIBBLE_PW"\n')
    os.chmod(helper, 0o700)
    opts = ["-o", "BatchMode=no", "-o", "PubkeyAuthentication=no", "-o", "NumberOfPasswordPrompts=1",
            "-o", "PreferredAuthentications=password,keyboard-interactive",
            "-o", "StrictHostKeyChecking=accept-new"]
    env = {"SSH_ASKPASS": helper, "SSH_ASKPASS_REQUIRE": "force", "KIBBLE_PW": password,
           "DISPLAY": os.environ.get("DISPLAY", ":0")}
    return Target(f"{user}@{ip}", opts, env)


def works(target, timeout=15):
    try:
        p = subprocess.run(ssh_argv("true", 12, target), capture_output=True, text=True, timeout=timeout,
                           env=child_env(target), stdin=subprocess.DEVNULL)
    except (subprocess.TimeoutExpired, OSError) as e:
        return False, str(e)
    if p.returncode == 0:
        return True, ""
    err = [l for l in p.stderr.splitlines() if l and not l.startswith(("**", "Warning"))]
    return False, (err[-1] if err else f"ssh exited {p.returncode}")


# ---------------------------------------------------------------- finding the phone on any network
# The phone is recognised by its SSH host key, not its address, so it can be found again after
# moving to another network. The scan only looks at this computer's own subnets, on port 22, and
# reads host keys. It never tries to log in to anything.

def load_conf():
    try:
        with open(CONF) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_conf(**kv):
    conf = load_conf()
    conf.update(kv)
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        json.dump(conf, f, indent=1)


def port_open(ip, port, timeout=0.6):
    try:
        socket.create_connection((ip, port), timeout).close()
        return True
    except OSError:
        return False


def keyscan(ip, port=22, timeout=3):
    """Host keys as 'type base64' strings; [] if nothing answers."""
    try:
        p = subprocess.run(["ssh-keyscan", "-T", str(timeout), "-p", str(port), ip],
                           capture_output=True, text=True, timeout=timeout + 3)
    except (subprocess.TimeoutExpired, OSError):
        return []
    return [f"{f[1]} {f[2]}" for f in (l.split() for l in p.stdout.splitlines() if not l.startswith("#"))
            if len(f) >= 3]


def local_subnets():
    try:
        out = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"],
                             capture_output=True, text=True).stdout
    except OSError:
        return []
    nets = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) > 3:
            i = ipaddress.ip_interface(parts[3])
            net = i.network if i.network.prefixlen >= 22 else ipaddress.ip_network(f"{i.ip}/22", strict=False)
            nets.append((net, str(i.ip)))
    return nets


def scan(on_status=None):
    """Hosts with ssh open on this computer's subnets: [{'ip', 'keys'}], the known phone first."""
    hosts = []
    for net, me in local_subnets():
        if on_status:
            on_status(f"scanning {net}")
        hosts += [str(h) for h in net.hosts() if str(h) != me]
    with concurrent.futures.ThreadPoolExecutor(64) as ex:
        opens = [ip for ip, ok in zip(hosts, ex.map(lambda ip: port_open(ip, 22), hosts)) if ok]
    if on_status:
        on_status(f"reading host keys of {len(opens)} host(s)")
    with concurrent.futures.ThreadPoolExecutor(8) as ex:
        found = [{"ip": ip, "keys": k} for ip, k in zip(opens, ex.map(keyscan, opens))]
    known = set(load_conf().get("hostkeys", []))
    for f in found:
        f["phone"] = bool(known & set(f["keys"]))
    return sorted(found, key=lambda f: (not f["phone"], f["ip"]))


def resolve_phone(port=22, log=None):
    """The phone's current address, or None. Tries the last known one first, then scans."""
    conf = load_conf()
    keys, ip = set(conf.get("hostkeys", [])), conf.get("ip")
    if not keys:
        return None
    if ip and port_open(ip, port, 1.5):
        if time.time() - conf.get("verified_at", 0) < 60 or keys & set(keyscan(ip)):
            save_conf(verified_at=time.time())
            return ip
    if log:
        log("kibble: the phone isn't at its last address, looking for it on this network...")
    for f in scan():
        if f["phone"] and port_open(f["ip"], port, 1.5):
            save_conf(ip=f["ip"], verified_at=time.time())
            if log:
                log(f"kibble: found it at {f['ip']}")
            return f["ip"]
    return None


def relay(ip, port):
    """Pipe stdin/stdout to ip:port; this is all an ssh ProxyCommand has to do."""
    s = socket.create_connection((ip, port), 10)
    stdin_open = True
    while True:
        r, _, _ = select.select([s] + ([0] if stdin_open else []), [], [])
        if s in r:
            d = s.recv(65536)
            if not d:
                return
            while d:
                d = d[os.write(1, d):]
        if 0 in r:
            d = os.read(0, 65536)
            if d:
                s.sendall(d)
            else:
                stdin_open = False
                s.shutdown(socket.SHUT_WR)


def ssh_g(alias):
    p = subprocess.run(["ssh", "-G", alias], capture_output=True, text=True)
    cfg = {}
    for l in p.stdout.splitlines():
        k, _, v = l.partition(" ")
        cfg.setdefault(k, []).append(v)
    return cfg


def learn(alias, ip=None):
    """Remember the phone behind an ssh host: its address, user, key and SSH host key."""
    cfg = ssh_g(alias)
    host = cfg.get("hostname", [""])[0]
    if ip is None and re.fullmatch(r"\d+\.\d+\.\d+\.\d+", host) and port_open(host, 22, 1.5):
        ip = host
    if ip is None:                       # already behind the ProxyCommand: ask the phone itself
        p = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", alias,
                            "ip -4 -o addr show wlan0"], capture_output=True, text=True)
        m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)", p.stdout)
        ip = m.group(1) if m else None
    keys = keyscan(ip) if ip else []
    if not keys:                         # last resort: what known_hosts already has for the name
        p = subprocess.run(["ssh-keygen", "-F", host], capture_output=True, text=True)
        keys = [f"{f[1]} {f[2]}" for f in (l.split() for l in p.stdout.splitlines() if not l.startswith("#"))
                if len(f) >= 3]
    ident = [os.path.expanduser(i) for i in cfg.get("identityfile", []) if os.path.exists(os.path.expanduser(i))]
    upd = dict(user=cfg.get("user", ["root"])[0], key=ident[0] if ident else None, learned_from=alias)
    if ip:
        upd.update(ip=ip, verified_at=time.time())
    if keys:
        upd["hostkeys"] = keys
    save_conf(**upd)
    return load_conf()


def ssh_config_block(hosts):
    me = os.path.abspath(__file__)
    return f"{MARK_A}\nHost {' '.join(hosts)}\n    ProxyCommand {shlex.quote(me)} connect %p\n{MARK_B}\n"


def strip_block(text):
    return re.sub(re.escape(MARK_A) + r".*?" + re.escape(MARK_B) + r"\n?", "", text, flags=re.S)


def cmd_ssh_config(args):
    hosts = [a for a in args if not a.startswith("--")] or ["phone-root", "arch"]
    cur = open(SSH_CONFIG).read() if os.path.exists(SSH_CONFIG) else ""
    if "--remove" in args:
        open(SSH_CONFIG, "w").write(strip_block(cur))
        print(f"removed the droidkibble block from {SSH_CONFIG}")
    elif "--install" in args:
        bak = SSH_CONFIG + ".bak-droidkibble"
        if cur and not os.path.exists(bak):
            open(bak, "w").write(cur)
            os.chmod(bak, 0o600)
        # first match wins in ssh_config, so this goes on top and only sets ProxyCommand
        open(SSH_CONFIG, "w").write(ssh_config_block(hosts) + "\n" + strip_block(cur))
        print(f"added to {SSH_CONFIG} (backup: {bak}). `ssh {hosts[0]}` now finds the phone on any network.")
    else:
        print(ssh_config_block(hosts), end="")
        print("\n# put that at the top of ~/.ssh/config, or run: kibble ssh-config --install")


def fetch(host=None):
    """One round trip. Returns (state, error)."""
    try:
        p = subprocess.run(ssh_argv(POLL, 15), capture_output=True, text=True, timeout=20, env=child_env(),
                           stdin=subprocess.DEVNULL)
    except (subprocess.TimeoutExpired, OSError) as e:
        return None, str(e)
    if p.returncode != 0 and "now=" not in p.stdout:
        lines = [l for l in p.stderr.splitlines() if l and not l.startswith("**")]
        return None, (lines[-1] if lines else f"ssh exited {p.returncode}")
    return parse(p.stdout), None


def parse(out):
    parts = {"head": [], "json": [], "once": []}
    cur = "head"
    for line in out.splitlines():
        if line == "---json":
            cur = "json"
        elif line == "---once":
            cur = "once"
        else:
            parts[cur].append(line)
    st = dict(l.partition("=")[::2] for l in parts["head"] if "=" in l)
    try:
        st["json"] = json.loads("\n".join(parts["json"]))
    except ValueError:
        st["json"] = None
    st["once"] = parts["once"]
    st["fetched"] = time.time()
    return st


def fresh_json(st):
    j = st and st.get("json")
    try:
        if j and abs(int(st["now"]) - int(j["time"])) <= STALE_S:
            return j
    except (KeyError, ValueError):
        pass
    return None


def fed_age(st):
    """Seconds since the watchdog was last fed, counted up to now (the file is rewritten right after each feed)."""
    j = fresh_json(st)
    if not j or not j["watchdog"]["open"]:
        return None
    then = j["time"] - j["watchdog"]["fed_ago_s"]
    return max(0, int(st["now"]) - then + int(time.time() - st["fetched"]))


def mood(st, err):
    if st is None or err:
        return "lost"
    if st.get("zygote") == "running":
        return "asleep"          # Android's own system_server feeds the watchdog
    age = fed_age(st)
    return "fed" if age is not None and age <= FED_OK_S else "hungry"



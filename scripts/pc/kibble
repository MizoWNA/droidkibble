def ellipse(c, cx, cy, rx, ry, col):
    cx += 1; cy += 1                                   # 1 px margin for the outline
    for y in range(int(cy - ry) - 1, int(cy + ry) + 2):
        for x in range(int(cx - rx) - 1, int(cx + rx) + 2):
            if 0 <= x < PW and 0 <= y < PH and ((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2 <= 1:
                c[y][x] = col


def box(c, x0, y0, x1, y1, col):
    for y in range(y0 + 1, y1 + 2):
        for x in range(x0 + 1, x1 + 2):
            if 0 <= x < PW and 0 <= y < PH:
                c[y][x] = col


def sprite(m, tick):
    """The dog as PH rows of PW palette colors (or None). Drawn back to front."""
    c = [[None] * PW for _ in range(PH)]
    wag = tick % 2
    tail = ([(10, 15), (8, 12), (6, 9), (5, 7)] if wag else [(10, 15), (7, 14), (4, 12), (2, 11)]) \
        if m == "fed" else [(10, 16), (8, 19), (7, 21)]
    for x, y in tail:
        ellipse(c, x, y, 1.7, 1.7, PAL["shade"])
    ellipse(c, 17, 16, 9, 6, PAL["tan"])               # body
    ellipse(c, 13, 18, 5, 4, PAL["shade"])             # hind leg
    box(c, 9, 21, 15, 22, PAL["tan"])                  # hind paw
    box(c, 22, 15, 26, 21, PAL["tan"])                 # front leg
    box(c, 21, 22, 27, 23, PAL["white"])               # front paws
    ellipse(c, 24, 15, 3, 4, PAL["white"])             # chest
    box(c, 21, 8, 27, 15, PAL["tan"])                  # neck
    box(c, 21, 12, 27, 13, PAL["red"])                 # collar
    box(c, 25, 14, 26, 15, PAL["gold"])                # tag
    ellipse(c, 22, 7, 2.5, 5, PAL["shade"])            # ear
    ellipse(c, 27, 8, 6, 5, PAL["tan"])                # head
    ellipse(c, 33, 10, 4, 3, PAL["white"])             # snout
    box(c, 36, 8, 37, 9, PAL["black"])                 # nose
    box(c, 30, 12, 35, 12, PAL["dark"])                # mouth
    if m == "fed":
        box(c, 33, 12, 34, 14, PAL["pink"])            # tongue
    if m == "asleep":
        box(c, 28, 7, 30, 7, PAL["black"])             # closed eye
    else:
        box(c, 28, 6, 29, 7, PAL["black"])
        c[7][30] = PAL["white"]                        # eye highlight
    if m == "hungry":
        for x, y in ((27, 4), (28, 4), (29, 5)):       # worried brow
            c[y + 1][x + 1] = PAL["dark"]
    box(c, 30, 21, 38, 22, PAL["bowl"])                # bowl
    box(c, 31, 23, 37, 23, PAL["bowl2"])
    if m == "fed":
        for x, y in ((32, 20), (34, 20), (36, 20), (33, 19), (35, 19)):
            c[y + 1][x + 1] = PAL["kib"]
    # dark outline around everything
    out = [row[:] for row in c]
    for y in range(PH):
        for x in range(PW):
            if c[y][x] is None and any(0 <= y + dy < PH and 0 <= x + dx < PW and c[y + dy][x + dx] is not None
                                       for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1))):
                out[y][x] = PAL["dark"]
    return out


# ---------------------------------------------------------------- the terminal UI

NAMED = {"lime": 154, "cyan": 51, "yellow": 227, "red": 203, "magenta": 207, "orange": 214,
         "grey": 244, "white": 255}
BASIC = {"lime": 2, "cyan": 6, "yellow": 3, "red": 1, "magenta": 5, "orange": 3, "grey": 7, "white": 7}
PAIRS = {}


def pair(fg, bg):
    key = (fg, bg)
    if key not in PAIRS:
        n = len(PAIRS) + 1
        if n >= curses.COLOR_PAIRS:
            return 0
        curses.init_pair(n, fg, bg)
        PAIRS[key] = n
    return PAIRS[key]


def col(name):
    if curses.COLORS >= 256:
        return curses.color_pair(pair(NAMED[name], -1))
    return curses.color_pair(pair(BASIC[name], -1)) | (curses.A_DIM if name == "grey" else 0)


def setup(scr):
    curses.raw()                              # so Ctrl-C arrives as a key, not a signal
    curses.curs_set(1)
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
    else:
        curses.COLORS = 0


def put(scr, y, x, s, attr=0):
    h, w = scr.getmaxyx()
    if 0 <= y < h and x < w:
        try:
            scr.addnstr(y, max(0, x), s[max(0, -x):], max(0, w - max(0, x) - (1 if y == h - 1 else 0)), attr)
        except curses.error:
            pass


HELP = [
    "Enter runs the line.   Tab / Ctrl-T switches between the Android shell and the Arch chroot.",
    "Left/Right/Home/End/Delete and Ctrl-A/E/W/K/U edit the line.  Up/Down = history.  PgUp/PgDn scroll.",
    "While a command runs, type to answer it (e.g. y for pacman).  Ctrl-C asks it to stop (or quits when idle).",
    "Ctrl-L or `clear` clears this pane.",
    "F5 / :headless  headless on/off now.   F6 / :boot  go headless at boot on/off.   :connect  change phone.",
    ":q or Ctrl-D quits.",
]


# ---------------------------------------------------------------- connect screen (no phone reachable)

def screen(scr, title, lines, footer=""):
    h, w = scr.getmaxyx()
    scr.erase()
    put(scr, 0, 0, " " * w, col("lime") | curses.A_REVERSE)
    put(scr, 0, 1, f"* DROIDKIBBLE *  {title}", col("lime") | curses.A_REVERSE | curses.A_BOLD)
    for i, (t, c, bold) in enumerate(lines[:h - 3]):
        put(scr, 2 + i, 2, t, col(c) | (curses.A_BOLD if bold else 0))
    put(scr, h - 1, 1, footer, col("grey"))
    scr.refresh()


def menu(scr, title, items, note="", footer="Up/Down and Enter to choose, Esc to go back"):
    """items: list of (label, color). Returns the chosen index, or None on Esc."""
    scr.timeout(-1)
    curses.curs_set(0)
    i = 0
    while True:
        lines = [(n, "yellow", False) for n in note.splitlines()] + ([("", "white", False)] if note else [])
        lines += [((">  " if k == i else "   ") + label, c if k != i else "lime", k == i)
                  for k, (label, c) in enumerate(items)]
        screen(scr, title, lines, footer)
        try:
            ch = scr.get_wch()
        except curses.error:
            continue
        if ch == curses.KEY_UP:
            i = (i - 1) % len(items)
        elif ch == curses.KEY_DOWN:
            i = (i + 1) % len(items)
        elif ch in ("\n", "\r"):
            curses.curs_set(1)
            return i
        elif ch in ("\x1b", "\x03"):
            curses.curs_set(1)
            return None


def ask(scr, title, prompt, default="", secret=False, note=""):
    scr.timeout(-1)
    curses.curs_set(1)
    buf = default
    while True:
        lines = [(n, "yellow", False) for n in note.splitlines()] + [(prompt, "white", True)]
        screen(scr, title, lines, "Enter to accept, Esc to go back")
        h, w = scr.getmaxyx()
        y = 2 + len(lines)
        shown = "*" * len(buf) if secret else buf
        put(scr, y, 2, "> " + shown, col("cyan") | curses.A_BOLD)
        scr.move(min(h - 2, y), min(w - 2, 4 + len(shown)))
        scr.refresh()
        try:
            ch = scr.get_wch()
        except curses.error:
            continue
        if ch in ("\n", "\r"):
            return buf
        if ch in ("\x1b", "\x03"):
            return None
        if ch in ("\x7f", "\b", curses.KEY_BACKSPACE):
            buf = buf[:-1]
        elif ch == "\x15":
            buf = ""
        elif isinstance(ch, str) and ch.isprintable():
            buf += ch


def busy(scr, title, text):
    screen(scr, title, [(text, "cyan", True)], "")


def run_with_spinner(scr, title, fn, first_text):
    """Run fn(on_status) in a thread while showing a moving line. Returns fn's result."""
    box = {"text": first_text, "out": None, "done": False}

    def work():
        try:
            box["out"] = fn(lambda t: box.update(text=t))
        finally:
            box["done"] = True

    threading.Thread(target=work, daemon=True).start()
    scr.timeout(150)
    k = 0
    while not box["done"]:
        screen(scr, title, [("|/-\\"[k % 4] + "  " + box["text"], "cyan", True)], "")
        k += 1
        try:
            scr.get_wch()
        except curses.error:
            pass
    return box["out"]


def private_keys():
    d = os.path.expanduser("~/.ssh")
    skip = {"config", "known_hosts", "known_hosts.old", "authorized_keys"}
    keys = []
    try:
        for n in sorted(os.listdir(d)):
            path = os.path.join(d, n)
            if n in skip or n.endswith((".pub", ".bak-droidkibble")) or not os.path.isfile(path):
                continue
            if os.path.exists(path + ".pub"):
                keys.append(path)
    except OSError:
        pass
    return keys


def connect_screen(scr, note=""):
    """Find an ssh host, choose a login, test it. Returns a Target, or None to quit."""
    title = "connect to your phone"
    while True:
        found = run_with_spinner(scr, title, scan, "scanning your network for ssh servers (port 22 only)...")
        items = []
        for f in found:
            keys = f["keys"][0].split()[0] if f["keys"] else "no host key"
            items.append((f"{f['ip']:<16} " + ("<- your phone (host key matches)" if f["phone"] else keys),
                          "lime" if f["phone"] else "white"))
        items += [("Type an address by hand", "cyan"), ("Scan again", "cyan"), ("Quit", "grey")]
        pick = menu(scr, title, items, (note + "\n" if note else "") +
                    (f"Found {len(found)} ssh server(s) on this network." if found else "No ssh servers found on this network."))
        note = ""
        if pick is None or pick == len(items) - 1:
            return None
        if pick == len(items) - 2:
            continue
        if pick == len(items) - 3:
            ip = ask(scr, title, "Address or hostname of the phone:")
            if not ip:
                continue
            ip, keys = ip.strip(), []
        else:
            ip, keys = found[pick]["ip"], found[pick]["keys"]
        conf = load_conf()
        user = ask(scr, title, f"Log in to {ip} as which user?", conf.get("user", "root"))
        if not user:
            continue
        while True:
            ks = private_keys()
            opts = [(f"key: {k.replace(os.path.expanduser('~'), '~')}", "white") for k in ks]
            opts += [("password", "white"), ("my ssh agent / default keys", "white"), ("(back)", "grey")]
            j = menu(scr, title, opts, note or f"How should I log in as {user}@{ip}?")
            note = ""
            if j is None or j == len(opts) - 1:
                break
            if j < len(ks):
                t, auth, key = key_target(ip, user, ks[j]), "key", ks[j]
            elif j == len(ks):
                pw = ask(scr, title, f"Password for {user}@{ip} (kept in memory only):", secret=True)
                if pw is None:
                    continue
                t, auth, key = password_target(ip, user, pw), "password", None
            else:
                t, auth, key = key_target(ip, user, None), "default", None
            busy(scr, title, f"trying {user}@{ip} ...")
            ok, err = works(t)
            if ok:
                hostkeys = keys or keyscan(ip)
                save_conf(ip=ip, user=user, key=key, auth=auth, verified_at=time.time(),
                          **({"hostkeys": hostkeys} if hostkeys else {}))
                return t
            note = f"That didn't work: {err}"


def initial_target(scr, host):
    title = "connecting"
    if host:
        busy(scr, title, f"connecting to {host} ...")
        t = Target(host)
        ok, err = works(t)
        if ok:
            return t
        return connect_screen(scr, f"Couldn't reach '{host}': {err}")
    conf = load_conf()
    note = ""
    if conf.get("hostkeys"):
        busy(scr, title, "looking for your phone ...")
        ip = resolve_phone()
        if ip:
            if conf.get("auth") == "password":
                pw = ask(scr, title, f"Password for {conf.get('user', 'root')}@{ip}:", secret=True)
                t = password_target(ip, conf.get("user", "root"), pw) if pw else None
            else:
                t = key_target(ip, conf.get("user", "root"), conf.get("key"))
            if t:
                ok, err = works(t)
                if ok:
                    return t
                note = f"Found the phone at {ip}, but logging in failed: {err}"
        else:
            note = "Couldn't find your phone on this network."
    return connect_screen(scr, note)


# ---------------------------------------------------------------- the dashboard

class App:
    def __init__(self, interval):
        self.interval = interval
        self.state = self.err = None
        self.out = collections.deque(maxlen=2000)
        self.scroll = 0
        self.buf, self.cur, self.hist, self.hpos = "", 0, [], 0
        self.lock = threading.Lock()
        self.active = None                       # the Shell running a command right now
        self.busy_since = 0.0
        self.partial = ""                        # output so far without a newline, e.g. a prompt
        self.quit = False
        self.want_connect = False
        self.confirm = None                      # (question, function) waiting for y/n
        self.remembered = False
        self.wake = threading.Event()
        self.reset_shells()

    def reset_shells(self):
        for sh in getattr(self, "shells", {}).values():
            sh.kill()
        self.shells = {"android": Shell(self, "android", "sh", "/data/local/tmp/kibble-in", "/data/local/tmp/kibble-in"),
                       "arch": Shell(self, "arch", f"{BASE}/arch.sh run sh", "/root/.kibble-in",
                                     "/data/arch/root/.kibble-in")}
        self.current = "android"
        self.active = None

    # -- background pieces
    def poller(self):
        while not self.quit:
            st, err = fetch()
            with self.lock:
                self.state, self.err = st, err
            j = fresh_json(st)
            if j and not self.remembered and TARGET.host and "@" not in TARGET.host:
                self.remembered = True           # an ssh alias: note where the phone is now
                threading.Thread(target=self.remember, args=(j["network"]["ip"],), daemon=True).start()
            self.wake.wait(self.interval)
            self.wake.clear()

    def remember(self, ip):
        try:
            learn(TARGET.host, ip=ip)
        except Exception:
            pass

    def add(self, line):
        with self.lock:
            self.out.append(line)

    def set_partial(self, shell, text):
        with self.lock:
            if self.active is shell:
                self.partial = text

    def finish(self, shell):
        with self.lock:
            if self.active is shell:
                self.active = None
                self.partial = ""
        self.wake.set()

    def submit(self, line):
        if line in ("clear", "cls", "@arch clear"):
            with self.lock:
                self.out.clear()
            self.scroll = 0
            return
        if line.startswith(":"):
            return self.colon(line[1:].strip())
        if self.active:                          # something is running: this is its input
            sh = self.active
            with self.lock:
                self.out.append(self.partial + line)
                self.partial = ""
            try:
                sh.send_input(line)
            except (OSError, ValueError) as e:
                self.add(f"[could not send input: {e}]")
            return
        name = "arch" if line.startswith("@arch ") else self.current
        shell = self.shells[name]
        cmd = line[6:].strip() if line.startswith("@arch ") else line
        if cmd == "clear":
            with self.lock:
                self.out.clear()
            return
        self.add(f"{shell.name}:{shell.cwd}$ {cmd}")
        with self.lock:
            self.active, self.busy_since, self.partial = shell, time.time(), ""
        try:
            shell.run(cmd)
        except (OSError, ValueError) as e:
            self.add(f"[could not send: {e}]")
            self.finish(shell)

    def colon(self, cmd):
        if cmd in ("q", "quit"):
            self.quit = True
        elif cmd == "headless":
            self.toggle_headless()
        elif cmd == "boot":
            self.toggle_boot()
        elif cmd == "connect":
            self.want_connect = True
        elif cmd in ("help", "?", ""):
            for l in HELP:
                self.add(l)
        else:
            self.add(f"[unknown command :{cmd}; try :help]")

    def stop_running(self, why):
        with self.lock:
            sh, self.active = self.active, None
        if sh:
            sh.kill()
            self.add(f"[{why}; the {sh.name} shell was dropped and starts fresh next time. "
                     f"The command may still be running on the phone.]")

    # -- headless controls
    def toggle_headless(self):
        st = self.state
        if not st:
            self.add("[can't reach the phone right now]")
        elif st.get("zygote") == "running":
            self.confirm = ("Go headless now? The screen goes dark and Android stops.  [y/N]",
                            lambda: self.detached("off"))
        else:
            self.confirm = ("Bring the Android UI back now?  [y/N]", lambda: self.detached("on"))

    def toggle_boot(self):
        st = self.state
        if not st:
            self.add("[can't reach the phone right now]")
        elif st.get("headless_flag") == "1":
            self.confirm = ("Stop going headless at boot?  [y/N]",
                            lambda: self.action(f"rm -f {BASE}/headless", "headless at boot: off"))
        else:
            self.confirm = ("Go headless at every boot?  [y/N]",
                            lambda: self.action(f"touch {BASE}/headless", "headless at boot: on"))

    def action(self, remote, label, then=None):
        def work():
            self.add(f"[{label} ...]")
            try:
                p = subprocess.run(ssh_argv(remote, 60), capture_output=True, text=True, timeout=70,
                                   env=child_env(), stdin=subprocess.DEVNULL)
                for l in (p.stdout + p.stderr).splitlines():
                    if l and not l.startswith("**"):
                        self.add(l)
                self.add(f"[{label}: done]" if p.returncode == 0 else f"[{label}: failed, exit {p.returncode}]")
            except (subprocess.TimeoutExpired, OSError) as e:
                self.add(f"[{label}: {e}]")
            self.wake.set()
            if then:
                then()
        threading.Thread(target=work, daemon=True).start()

    def detached(self, which):
        """ui.sh takes a while and stops or starts Android's services, so run it detached and read its log."""
        log = "/data/local/tmp/kibble-ui.log"
        remote = f"nohup sh -c '{BASE}/ui.sh {which}' > {log} 2>&1 < /dev/null & echo started"

        def later():
            time.sleep(25)
            self.action(f"cat {log}", f"ui.sh {which} log")
        self.action(remote, f"ui.sh {which}", then=lambda: threading.Thread(target=later, daemon=True).start())

    # -- drawing
    def draw(self, scr):
        h, w = scr.getmaxyx()
        scr.erase()

        def P(y, x, s, attr=0):
            put(scr, y, x, s, attr)

        def segs(y, x, pieces):
            for text, color in pieces:
                P(y, x, text, col(color))
                x += len(text)

        if h < 18 or w < 60:
            P(0, 0, "terminal too small (need about 60x18, 100x30 is nicer)")
            scr.refresh()
            return
        with self.lock:
            st, err, out, active = self.state, self.err, list(self.out), self.active
            partial = self.partial if self.active else ""
        m = mood(st, err)
        color256 = curses.COLORS >= 256
        j = fresh_json(st)

        age = f"updated {fmt_dur(time.time() - st['fetched'])} ago" if st else "no data"
        up = f"   UP {fmt_dur(j['uptime_s'])}" if j else ""
        P(0, 0, " " * w, col("lime") | curses.A_REVERSE)
        P(0, 1, "* DROIDKIBBLE *", col("lime") | curses.A_REVERSE | curses.A_BOLD)
        info = f"{TARGET.host}{up}   {age} "
        P(0, max(18, w - len(info)), info, col("lime") | curses.A_REVERSE)

        term_h = max(6, h // 3)
        field_top, field_h = 1, h - term_h - 2
        tick = int(time.time() * 2)
        if color256:
            spr, dw, dh = sprite(m, tick), PW, PH // 2
        else:
            art = ascii_dog(m, tick)
            spr, dw, dh = None, len(art[0]), len(art)
        cap, capcol = CAPTION[m]
        dy = field_top + max(0, (field_h - dh - 2) // 2)
        dx = (w - dw) // 2
        if spr:
            for r in range(dh):
                for x in range(dw):
                    top, bot = spr[2 * r][x], spr[2 * r + 1][x]
                    if top is None and bot is None:
                        continue
                    if bot is None:
                        P(dy + r, dx + x, "▀", curses.color_pair(pair(top, -1)))
                    elif top is None:
                        P(dy + r, dx + x, "▄", curses.color_pair(pair(bot, -1)))
                    else:
                        P(dy + r, dx + x, "▀", curses.color_pair(pair(top, bot)))
            if m == "asleep":
                P(dy + 1, dx + 31, "z" if tick % 2 else "Z", col("cyan") | curses.A_BOLD)
                P(dy, dx + 34, "Z" if tick % 2 else "z", col("cyan") | curses.A_BOLD)
            elif m == "lost":
                P(dy + 1, dx + 33, "?", col("red") | curses.A_BOLD)
                P(dy, dx + 36, "?" if tick % 2 else " ", col("red") | curses.A_BOLD)
        else:
            for i, l in enumerate(art):
                P(dy + i, dx, l, col(capcol) | curses.A_BOLD)
        P(dy + dh + 1, (w - len(cap)) // 2, cap, col(capcol) | curses.A_BOLD)

        side = dx - 2
        left, right = panels(st, err, bw=max(8, min(14, side - 12)))
        if side >= 24:
            for (lines, x0, ttl, tc) in ((left, 1, " VITALS ", "cyan"), (right, dx + dw + 1, " LINK ", "magenta")):
                pw = side - 1 if x0 == 1 else w - x0 - 1
                P(dy, x0, "┌─" + ttl + "─" * max(0, pw - len(ttl) - 3) + "┐", col(tc))
                nrows = min(len(lines), field_h - 2)
                for i in range(nrows + 1):
                    P(dy + 1 + i, x0, "│", col(tc))
                    P(dy + 1 + i, x0 + pw - 1, "│", col(tc))
                    if i < nrows:
                        segs(dy + 1 + i, x0 + 2, lines[i])
                P(dy + nrows + 1, x0, "└" + "─" * (pw - 2) + "┘", col(tc))
        else:
            y = dy + dh + 3
            for line in left + right:
                if y < field_top + field_h:
                    segs(y, 2, line)
                    y += 1

        # terminal: the bottom third
        sep = h - term_h - 1
        cur = "arch" if self.buf.startswith("@arch ") else self.current
        shell = self.shells[cur]
        title = f" TERMINAL  {shell.name}:{shell.cwd} "
        P(sep, 0, "━" * w, col("orange"))
        P(sep, 2, title[:w - 4], col("orange") | curses.A_BOLD)
        hint = " running: type to answer it, Ctrl-C stops " if active else " Tab shell · F5 headless · F6 boot · :help "
        P(sep, max(len(title) + 4, w - len(hint) - 2), hint, col("yellow" if active else "grey") | (curses.A_BOLD if active else 0))
        room = term_h - 1
        if partial:
            out.append("\0" + partial)             # marks a live prompt line
        end = len(out) - self.scroll
        for i, l in enumerate(out[max(0, end - room):end]):
            if l.startswith("\0"):
                P(sep + 1 + i, 1, l[1:], col("yellow") | curses.A_BOLD)
                continue
            first = l.split(" ", 1)[0]
            attr = col("cyan") if first.endswith("$") else col("red") if l.startswith("[") else 0
            P(sep + 1 + i, 1, l, attr)
        if self.confirm:
            P(h - 1, 0, self.confirm[0], col("yellow") | curses.A_BOLD)
            try:
                scr.move(h - 1, min(w - 2, len(self.confirm[0])))
            except curses.error:
                pass
        else:
            prompt = "answer> " if active else f"{shell.name}> "
            avail = max(5, w - len(prompt) - 2)
            off = max(0, self.cur - avail + 1)
            P(h - 1, 0, prompt, col("yellow" if active else "orange") | curses.A_BOLD)
            P(h - 1, len(prompt), self.buf[off:off + avail], curses.A_BOLD)
            try:
                scr.move(h - 1, min(w - 2, len(prompt) + self.cur - off))
            except curses.error:
                pass
        scr.refresh()

    def key(self, ch):
        if self.confirm:
            q, fn = self.confirm
            self.confirm = None
            if ch in ("y", "Y"):
                fn()
            else:
                self.add("[cancelled]")
            return
        b, c = self.buf, self.cur
        if ch == "\x04":
            self.quit = True
        elif ch == "\x03":
            if self.active:
                self.add("[Ctrl-C: asking the command to stop]")
                self.active.interrupt(self.busy_since)
            else:
                self.quit = True
        elif ch in ("\n", "\r"):
            line = b.strip()
            self.buf, self.cur = "", 0
            if line:
                self.hist.append(line)
                self.hpos = len(self.hist)
                self.scroll = 0
                self.submit(line)
        elif ch in ("\t", "\x14"):
            self.current = "arch" if self.current == "android" else "android"
        elif ch == "\x0c":
            with self.lock:
                self.out.clear()
            self.scroll = 0
        elif ch in ("\x7f", "\b", curses.KEY_BACKSPACE):
            if c:
                self.buf, self.cur = b[:c - 1] + b[c:], c - 1
        elif ch == curses.KEY_DC:
            self.buf = b[:c] + b[c + 1:]
        elif ch == curses.KEY_LEFT:
            self.cur = max(0, c - 1)
        elif ch == curses.KEY_RIGHT:
            self.cur = min(len(b), c + 1)
        elif ch in (curses.KEY_HOME, "\x01"):
            self.cur = 0
        elif ch in (curses.KEY_END, "\x05"):
            self.cur = len(b)
        elif ch == "\x15":
            self.buf, self.cur = b[c:], 0
        elif ch == "\x0b":
            self.buf = b[:c]
        elif ch == "\x17":
            j = len(b[:c].rstrip())
            k = b[:j].rfind(" ") + 1
            self.buf, self.cur = b[:k] + b[c:], k
        elif ch == curses.KEY_UP and self.hist:
            self.hpos = max(0, self.hpos - 1)
            self.buf = self.hist[self.hpos]
            self.cur = len(self.buf)
        elif ch == curses.KEY_DOWN and self.hist:
            self.hpos = min(len(self.hist), self.hpos + 1)
            self.buf = self.hist[self.hpos] if self.hpos < len(self.hist) else ""
            self.cur = len(self.buf)
        elif ch == curses.KEY_PPAGE:
            self.scroll = min(len(self.out), self.scroll + 5)
        elif ch == curses.KEY_NPAGE:
            self.scroll = max(0, self.scroll - 5)
        elif ch == curses.KEY_F5:
            self.toggle_headless()
        elif ch == curses.KEY_F6:
            self.toggle_boot()
        elif isinstance(ch, str) and ch.isprintable():
            self.buf, self.cur = b[:c] + ch + b[c:], c + 1

    def main(self, scr):
        scr.timeout(250)
        threading.Thread(target=self.poller, daemon=True).start()
        while not self.quit:
            if self.want_connect:
                self.want_connect = False
                t = connect_screen(scr)
                if t:
                    set_target(t)
                    self.reset_shells()
                    with self.lock:
                        self.state = self.err = None
                        self.out.clear()
                    self.remembered = False
                    self.wake.set()
                scr.timeout(250)
                curses.curs_set(1)
            self.draw(scr)
            try:
                self.key(scr.get_wch())
            except curses.error:
                pass
        for sh in self.shells.values():
            sh.kill()


def set_target(t):
    global TARGET
    TARGET = t


def snapshot(host):
    set_target(Target(host))
    st, err = fetch()
    left, right = panels(st, err)
    print("\n".join(ascii_dog(mood(st, err), 0)))
    print(CAPTION[mood(st, err)][0])
    for line in left + right:
        if line:
            print("".join(t for t, _ in line))
    return 0 if st else 1


def run(scr, a):
    setup(scr)
    t = initial_target(scr, a.host)
    if not t:
        return
    set_target(t)
    App(max(2, a.interval)).main(scr)


def main():
    argv = sys.argv[1:]
    cmd = argv[0] if argv else ""
    if cmd == "connect":                    # ssh ProxyCommand: `kibble connect %p`
        port = int(argv[1]) if len(argv) > 1 else 22
        ip = resolve_phone(port, log=lambda m: print(m, file=sys.stderr))
        if not ip:
            print("kibble: can't find the phone on this network (run `kibble learn <ssh-host>` while it is "
                  "reachable, or run `kibble` to set it up)", file=sys.stderr)
            sys.exit(1)
        relay(ip, port)
        return
    if cmd == "find":
        ip = resolve_phone(log=lambda m: print(m, file=sys.stderr))
        print(ip or "", end="\n" if ip else "")
        sys.exit(0 if ip else 1)
    if cmd == "learn" and len(argv) == 2:
        c = learn(argv[1])
        print(f"remembered the phone: {c.get('ip', '?')} as {c.get('user')}, "
              f"{len(c.get('hostkeys', []))} host key(s), in {CONF}")
        sys.exit(0 if c.get("hostkeys") else 1)
    if cmd == "ssh-config":
        cmd_ssh_config(argv[1:])
        return
    ap = argparse.ArgumentParser(description="arcade-style terminal dashboard for a droidkibble phone")
    ap.add_argument("host", nargs="?", default="", help="ssh host that logs in as root on the phone "
                    "(optional: without it the phone is found automatically)")
    ap.add_argument("--interval", type=float, default=5, help="seconds between updates (default 5)")
    ap.add_argument("--once", action="store_true", help="print one snapshot and exit")
    a = ap.parse_args(argv)
    if a.once or not sys.stdout.isatty():
        sys.exit(snapshot(a.host))
    os.environ.setdefault("ESCDELAY", "50")
    try:
        curses.wrapper(lambda scr: run(scr, a))
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()

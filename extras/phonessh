#!/usr/bin/env bash
# phonessh: SSH into the phone's Arch chroot with your local oh-my-zsh setup, recolored so
# you can tell at a glance which machine a terminal is on.
#
# An optional extra, not needed by the rest of droidkibble. It assumes you use zsh with
# oh-my-zsh on your computer, and derives the phone's theme from your own (recoloring the
# green/red user@host to magenta and blue to cyan). Copy it somewhere on your PATH, or alias it.
#
#   phonessh            open a zsh session on the phone
#   phonessh <cmd...>   run one command on the phone
#   phonessh --root     Android root shell instead of the Arch chroot
#   phonessh --sync     (re)install zsh and copy your oh-my-zsh + generated theme to the phone
#
# Hosts "arch" (chroot, port 2222) and "phone-root" (Android, port 22) come from ~/.ssh/config.

set -u
# ssh hosts from ~/.ssh/config: the Arch chroot (port 2222) and the Android root shell (port 22)
HOST="${PHONESSH_HOST:-arch}"
ROOT_HOST="${PHONESSH_ROOT_HOST:-phone-root}"
THEME="${PHONESSH_THEME:-bira}"   # your local oh-my-zsh theme to derive from
# kitty's terminfo doesn't exist on the phone; a plain xterm-256color works everywhere
export TERM=xterm-256color

reachable() { ssh -o ConnectTimeout=5 -o BatchMode=yes "$1" true 2>/dev/null; }

unreachable_hint() {
    echo "phonessh: can't reach '$1'. Is the phone on and on Wi-Fi?" >&2
    echo "          If you switched networks: kibble ssh-config --install makes ssh find the phone by itself." >&2
    echo "          try: ping \$(ssh -G $1 | awk '/^hostname /{print \$2}')" >&2
    exit 1
}

sync_shell() {
    reachable "$HOST" || unreachable_hint "$HOST"
    tmp=$(mktemp -d); trap 'rm -rf "${tmp:-}"' EXIT

    echo "==> zsh on the phone"
    if ssh "$HOST" 'command -v zsh >/dev/null'; then
        echo "    already installed"
    else
        echo "    installing (small download through the phone's pacman)"
        ssh "$HOST" 'pacman -Sy --noconfirm --needed zsh' || { echo "pacman failed" >&2; exit 1; }
    fi

    echo "==> oh-my-zsh (copied from this PC over the LAN, no internet)"
    tar -C "$HOME" --exclude=.git --exclude='.oh-my-zsh/cache' -cf - .oh-my-zsh | ssh "$HOST" 'tar -C ~ --no-same-owner -xf -'

    echo "==> theme: your $THEME, colors shifted"
    # green/red user@host -> magenta, blue path -> cyan, hostname -> "phone"
    sed -E \
        -e 's/%\(!\.%\{\$fg\[red\]%\}\.%\{\$fg\[green\]%\}\)/%{$fg[magenta]%}/' \
        -e 's/fg\[blue\]/fg[cyan]/g' \
        -e 's/%n@%m/%n@phone/' \
        "$HOME/.oh-my-zsh/themes/$THEME.zsh-theme" > "$tmp/$THEME-phone.zsh-theme"
    ssh "$HOST" 'mkdir -p ~/.oh-my-zsh/custom/themes' &&
        ssh "$HOST" "cat > ~/.oh-my-zsh/custom/themes/$THEME-phone.zsh-theme" < "$tmp/$THEME-phone.zsh-theme"

    echo "==> .zshrc"
    cat > "$tmp/zshrc" <<EOF
# Generated by phonessh --sync. Edit that script, not this file.
export LANG=C.UTF-8
export ZSH="\$HOME/.oh-my-zsh"
ZSH_THEME="$THEME-phone"
DISABLE_AUTO_UPDATE="true"
plugins=(git)
source \$ZSH/oh-my-zsh.sh
[[ -o interactive ]] && [[ -x ~/.phone-greeting ]] && ~/.phone-greeting
EOF
    ssh "$HOST" 'cat > ~/.zshrc' < "$tmp/zshrc"

    echo "==> greeting"
    make_greeting > "$tmp/greeting"
    ssh "$HOST" 'cat > ~/.phone-greeting && chmod 755 ~/.phone-greeting' < "$tmp/greeting"

    echo "done. Run: phonessh"
}

# Builds the remote greeting. The banner art is rendered here (with figlet, like on the PC)
# and embedded, so the phone needs no figlet/python/fastfetch.
make_greeting() {
    local block small
    block=$(figlet -f block PHONE 2>/dev/null || echo "PHONE")
    small=$(figlet -f small PHONE 2>/dev/null || echo "PHONE")
    cat <<EOF
#!/usr/bin/env bash
cols=\$(tput cols 2>/dev/null || echo 80)
accent=\$'\033[38;2;186;104;200m'   # your orange, shifted to purple
muted=\$'\033[38;2;138;138;130m'
reset=\$'\033[0m'

center() { while IFS= read -r l; do pad=\$(( (cols - \${#l}) / 2 )); (( pad < 0 )) && pad=0; printf '%*s%s\n' \$pad '' "\$l"; done; }

if (( cols >= 90 )); then art=\$(cat <<'ART'
$block
ART
)
elif (( cols >= 50 )); then art=\$(cat <<'ART'
$small
ART
)
else art="PHONE"; fi

printf '%s' "\$accent"; printf '%s\n' "\$art" | center; printf '%s' "\$reset"

up=\$(awk '{d=int(\$1/86400); h=int((\$1%86400)/3600); m=int((\$1%3600)/60); if(d)printf "%dd ",d; printf "%dh %dm",h,m}' /proc/uptime)
ram=\$(free -m | awk '/Mem:/ {printf "%d/%d MB", \$3, \$2}')
bat=\$(cat /sys/class/power_supply/battery/capacity 2>/dev/null)
tmp=\$(cat /sys/class/power_supply/battery/temp 2>/dev/null)
line="up \$up  |  ram \$ram"
[ -n "\$bat" ] && line="\$line  |  battery \${bat}%"
[ -n "\$tmp" ] && line="\$line  |  \$((tmp/10)).\$((tmp%10))C"
printf '%s' "\$muted"
{ printf '%s\n' "\$line"; printf '%s • %s\n' "\$USER" "\${PWD/#\$HOME/~}"; } | center
printf '%s' "\$reset"
echo
EOF
}

case "${1:-}" in
    --sync)  sync_shell ;;
    --root)  reachable "$ROOT_HOST" || unreachable_hint "$ROOT_HOST"; exec ssh -t "$ROOT_HOST" ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
    "")
        reachable "$HOST" || unreachable_hint "$HOST"
        if ssh "$HOST" 'test -x /usr/bin/zsh && test -f ~/.zshrc'; then
            exec ssh -t "$HOST" 'exec zsh -l'
        else
            echo "phonessh: zsh isn't set up on the phone yet. Run: phonessh --sync (falling back to bash)" >&2
            exec ssh -t "$HOST"
        fi ;;
    *)       reachable "$HOST" || unreachable_hint "$HOST"; exec ssh "$HOST" "$@" ;;
esac
